# ============================================================================
# LUXEDGE V2 — ENVIRONMENT VARIABLES (NAMES ONLY)
#
# These secrets are read ONLY by the serverless functions in /api/*
# (Vercel → Project Settings → Environment Variables). They are NEVER
# bundled into the browser, never stored in localStorage, never committed.
#
# Copy this file to .env for local development, and add the same names (with
# real values) in the Vercel dashboard for production.
# ============================================================================

# AI provider keys (optional — add only the providers you use)
OPENAI_API_KEY=
# DeepSeek supports key rotation: put extra keys in DEEPSEEK_API_KEY_1..N (or
# comma-separate multiple keys in DEEPSEEK_API_KEY). The server rotates through
# them round-robin and falls back to the next key when one fails.
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Web scraping token (optional — enables credential-backed AliExpress import
# through the /api/fetch-page endpoint instead of public proxies)
SCRAPE_DO_TOKEN=

# Omnisend email/SMS marketing API key (optional — powers Admin → Email Marketing)
# Server-only. Used by /api/omnisend/status to verify the connection; never exposed.
OMNISEND_API_KEY=

# Adsterra advertising monetization network (Publisher ID & API token for reporting / ads)
# Server-only. Used by /api/admin/adsterra to verify connection and fetch publisher metrics.
ADSTERRA_API_TOKEN=
ADSTERRA_PUBLISHER_ID=

# ----------------------------------------------------------------------------
# CJ Dropshipping (Phase 4C — official supplier API, READ/RESEARCH only)
# ----------------------------------------------------------------------------
# Server-only. The Product Scout's Supplier Discovery adapter calls CJ through
# the protected /api/suppliers/cj proxy with the admin JWT; this key is read
# ONLY inside the serverless functions and never reaches the browser.
# Get it from your CJ Dropshipping account (API section).
CJ_API_KEY=

# ----------------------------------------------------------------------------
# Supabase (Phase 3A — real auth + data layer)
# ----------------------------------------------------------------------------
# Public key — safe for the browser (RLS protects the tables). Accepts the
# legacy anon key OR the new publishable key (sb_publishable_...).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never exposed to Vite/browser code. Accepts the legacy
# service_role key OR the new secret key (sb_secret_...). Used by serverless
# functions that need privileged database access.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only (OPTIONAL): the project's JWT signing secret (Dashboard →
# Project Settings → API → JWT Secret). When set, /api/* verifies admin
# access tokens locally (fast). When absent, /api/* validates tokens
# remotely via Supabase's /auth/v1/user endpoint instead — same admin claim
# (app_metadata.role = 'admin'), one extra network call.
# FAIL CLOSED either way: if neither this nor VITE_SUPABASE_* is configured,
# the protected endpoints return 503 and admin auth is disabled.
SUPABASE_JWT_SECRET=

# Stripe (REAL CHECKOUT — serverless /api/checkout + /api/webhook)
# ----------------------------------------------------------------------------
# Server-only. Never expose to Vite/browser code (no VITE_STRIPE_SECRET_KEY).
# STRIPE_SECRET_KEY: sk_test_... (test) or sk_live_... (production).
# STRIPE_PUBLISHABLE_KEY: pk_test_... / pk_live_... (browser-safe, used only
#   to render the "powered by Stripe" honest payment state on the storefront).
# STRIPE_WEBHOOK_SECRET: whsec_... from the Stripe Dashboard (Webhooks) —
#   required for /api/webhook signature verification (idempotent orders).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Shippo — address validation + live US carrier shipping rates
# ---------------------------------------------------------------------------
# Server-only. The /api/shippo proxy and /api/checkout/onsite handler use these
# to validate addresses (USPS) and fetch real shipping quotes. The token never
# reaches the browser.
# SHIPPO_TOKEN        — Private API token from shippo.com/account → API Keys.
# SHIPPO_FROM_NAME    — Sender / return-address name for rate lookups.
# SHIPPO_FROM_STREET  — Sender street address.
# SHIPPO_FROM_CITY    — Sender city.
# SHIPPO_FROM_STATE   — Sender state abbreviation (e.g. CA).
# SHIPPO_FROM_ZIP     — Sender ZIP code.
# SHIPPO_FROM_COUNTRY — Sender country code (default US).
SHIPPO_API_KEY=
SHIPPO_FROM_NAME=
SHIPPO_FROM_ADDRESS=
SHIPPO_FROM_CITY=
SHIPPO_FROM_STATE=
SHIPPO_FROM_ZIP=

# Embani ERP sync (Admin → Orders → ERP Sync). Server-only secrets.
# ----------------------------------------------------------------------------
# The admin browser NEVER holds these: /api/admin/erp calls the ERP webhook
# server-side. Env values always win over the values attached via the Admin UI
# (which are stored in the app_settings table, never sent back to the browser).
# EMBANI_ERP_WEBHOOK_URL — e.g. https://erp.yourdomain.com/api/luxedge/orders
# EMBANI_ERP_API_TOKEN   — Bearer token the ERP webhook expects (if any).
EMBANI_ERP_WEBHOOK_URL=
EMBANI_ERP_API_TOKEN=
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_ADSENSE_CLIENT_SECRET=
ADSENSE_REDIRECT_URI=https://luxedge.us/api/adsense/oauth/callback
ADSENSE_PUBLISHER_ID=pub-5473713135927706

# ----------------------------------------------------------------------------
# YouTube Media Hub (Phase — /media + /video-sitemap.xml)
# ----------------------------------------------------------------------------
# Server-only. The Admin Media manager syncs the official channel uploads
# through POST /api/media/sync. No keys ever reach the browser.
#   YOUTUBE_API_KEY     — Google Cloud API key with the YouTube Data API v3 enabled
#   YOUTUBE_CHANNEL_ID  — the official channel id (e.g. UC...). Channel About →
#                         Share → Channel ID.
#   YOUTUBE_CHANNEL_URL — the official channel URL used by Subscribe CTAs and the
#                         footer. Filled with the verified channel below.
YOUTUBE_API_KEY=
# Verified from the owner data of the channel's real video YOBlXCyOh28 (2026-09-03).
YOUTUBE_CHANNEL_ID=UCPvPDstYz61AebGhKzKS1lw
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@TheAIWithSalman
